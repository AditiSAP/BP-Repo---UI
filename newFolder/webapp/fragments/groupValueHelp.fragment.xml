<core:FragmentDefinition xmlns:core="sap.ui.core"
	xmlns="sap.m">
	<Dialog title="{i18n>vhGroupTitle}" contentWidth="50%">
		<VBox>
			<SearchField liveChange="onVHConsGrpSearch" width="100%" />
			<Table mode="SingleSelectMaster" items="{consGrpModel>/results}" itemPress="onVHItemSelect">
				<columns>
					<Column width="30%">
						<Text text="{i18n>ID}" />
					</Column>
					<Column width="70%">
						<Text text="{i18n>desc}" />
					</Column>
				</columns>
				<items>
					<ColumnListItem type="Active">
						<cells>
							<Text text="{consGrpModel>ConsolGroup}" />
							<Text text="{consGrpModel>ConsolGroupText}" />
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</VBox>
		<footer>
			<OverflowToolbar>
				<ToolbarSpacer />
				<Button text="Close" press="onCloseValueHelp" />
			</OverflowToolbar>
		</footer>
	</Dialog>
</core:FragmentDefinition>
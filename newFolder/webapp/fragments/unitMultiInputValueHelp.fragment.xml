<core:FragmentDefinition xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<TableSelectDialog
		multiSelect="true"
		rememberSelections="true"
		title="{i18n>vhUnitTitle}"
		items="{conUnitVHModel>/units}"
		search=".onVHConsUnitMultiSearch"
		confirm=".onVHUnitSelect">
		<columns>
			<Column width="30%">
				<Text text="{i18n>ID}" />
			</Column>
			<Column width="70%">
				<Text text="{i18n>desc}" />
			</Column>
		</columns>
		<ColumnListItem type="Active">
			<cells>
				<Text text="{conUnitVHModel>ConUnit}" />
				<Text text="{conUnitVHModel>ConUnitText}" />
			</cells>
		</ColumnListItem>
	</TableSelectDialog>
</core:FragmentDefinition>
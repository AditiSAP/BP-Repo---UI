<mvc:View controllerName="com.bpcfn.jobscheduler.controller.Home"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:mdc="sap.ui.mdc"
    xmlns:mdct="sap.ui.mdc.table"
    xmlns:mdcvh="sap.ui.mdc.valuehelp"
    xmlns:mdcvc="sap.ui.mdc.valuehelp.content"
    xmlns:vm="sap.ui.fl.variants">

    <f:DynamicPage id="Home" class="sapUiNoContentPadding">

        <f:dependents>

            <mdc:ValueHelp id="jobNameVH"
                delegate="{name:'sap/ui/mdc/ValueHelpDelegate', payload:{}}">
                <mdc:typeahead>
                    <mdcvh:Popover id="jobNameVHPopover">
                        <mdcvc:MTable id="jobNameVHMTableP" keyPath="Jobname" descriptionPath="Jobname">
                            <Table id="jobNameVHTableP" items="{path:'custModel>/VH_Job', length:99999}" mode="SingleSelectMaster">
                                <columns>
                                    <Column id="jobNameVHColP"><Label id="jobNameVHLabelP" text="{i18n>JobName}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="jobNameVHItemP" type="Active">
                                        <cells><Text id="jobNameVHTxtP" text="{custModel>Jobname}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                    </mdcvh:Popover>
                </mdc:typeahead>
                <mdc:dialog>
                    <mdcvh:Dialog id="jobNameVHDialog" title="{i18n>JobName}">
                        <mdcvc:MTable id="jobNameVHMTableD" keyPath="Jobname" descriptionPath="Jobname">
                            <Table id="jobNameVHTableD" items="{path:'custModel>/VH_Job', length:99999}" mode="SingleSelectMaster">
                                <columns>
                                    <Column id="jobNameVHColD"><Label id="jobNameVHLabelD" text="{i18n>JobName}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="jobNameVHItemD" type="Active">
                                        <cells><Text id="jobNameVHTxtD" text="{custModel>Jobname}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                        <mdcvc:Conditions id="jobNameVHConditions"/>
                    </mdcvh:Dialog>
                </mdc:dialog>
            </mdc:ValueHelp>

            <mdc:ValueHelp id="createdByVH"
                delegate="{name:'sap/ui/mdc/ValueHelpDelegate', payload:{}}">
                <mdc:typeahead>
                    <mdcvh:Popover id="createdByVHPopover">
                        <mdcvc:MTable id="createdByVHMTableP" keyPath="Bname" descriptionPath="Bname">
                            <Table id="createdByVHTableP" items="{path:'custModel>/VH_GenericUser', length:99999}" mode="SingleSelectMaster">
                                <columns>
                                    <Column id="createdByVHColP"><Label id="createdByVHLabelP" text="{i18n>CreatedBy}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="createdByVHItemP" type="Active">
                                        <cells><Text id="createdByVHTxtP" text="{custModel>Bname}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                    </mdcvh:Popover>
                </mdc:typeahead>
                <mdc:dialog>
                    <mdcvh:Dialog id="createdByVHDialog" title="{i18n>CreatedBy}">
                        <mdcvc:MTable id="createdByVHMTableD" keyPath="Bname" descriptionPath="Bname">
                            <Table id="createdByVHTableD" items="{path:'custModel>/VH_GenericUser', length:99999}" mode="SingleSelectMaster">
                                <columns>
                                    <Column id="createdByVHColD"><Label id="createdByVHLabelD" text="{i18n>CreatedBy}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="createdByVHItemD" type="Active">
                                        <cells><Text id="createdByVHTxtD" text="{custModel>Bname}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                        <mdcvc:Conditions id="createdByVHConditions"/>
                    </mdcvh:Dialog>
                </mdc:dialog>
            </mdc:ValueHelp>

            <mdc:ValueHelp id="statusVH"
                delegate="{name:'sap/ui/mdc/ValueHelpDelegate', payload:{}}">
                <mdc:typeahead>
                    <mdcvh:Popover id="statusVHPopover">
                        <mdcvc:MTable id="statusVHMTableP" keyPath="key" descriptionPath="text">
                            <Table id="statusVHTableP" items="{path:'statusFilterModel>/items'}" mode="MultiSelect">
                                <columns>
                                    <Column id="statusVHColP"><Label id="statusVHLabelP" text="{i18n>Status}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="statusVHItemP" type="Active">
                                        <cells><Text id="statusVHTxtP" text="{statusFilterModel>text}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                    </mdcvh:Popover>
                </mdc:typeahead>
            </mdc:ValueHelp>

        </f:dependents>

        <f:title>
            <f:DynamicPageTitle id="homePageTitle">
                <f:heading>
                    <vm:VariantManagement id="filterbarVM" for="filterbar"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader id="homePageHeader">
                <mdc:FilterBar id="filterbar"
                    delegate="{name:'com/bpcfn/jobscheduler/util/FilterBarDelegate', payload:{}}"
                    search=".onRefreshData"
                    showClearButton="true"
                    p13nMode="Item"
                    liveMode="false">

                    <mdc:filterItems>

                        <mdc:FilterField
                            id="idJobNameFilter"
                            propertyKey="jobname"
                            label="{i18n>JobName}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="1"
                            operators="Contains,EQ"
                            delegate="{name: 'sap/ui/mdc/field/FieldBaseDelegate', payload: {}}"
                            valueHelp="jobNameVH"/>

                        <mdc:FilterField
                            id="idDateFilter"
                            propertyKey="dateRange"
                            label="{i18n>Date}"
                            dataType="sap.ui.model.type.Date"
                            maxConditions="1"
                            required="true"
                            operators="BT,GE,LE"
                            placeholder="{i18n>DateRangePlaceholder}"
                            delegate="{name: 'sap/ui/mdc/field/FieldBaseDelegate', payload: {}}"/>

                        <mdc:FilterField
                            id="idCreatedByFilter"
                            propertyKey="createdby"
                            label="{i18n>CreatedBy}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="1"
                            operators="Contains,EQ"
                            delegate="{name: 'sap/ui/mdc/field/FieldBaseDelegate', payload: {}}"
                            valueHelp="createdByVH"/>

                        <mdc:FilterField
                            id="idStatusFilter"
                            propertyKey="status"
                            label="{i18n>Status}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="-1"
                            operators="EQ"
                            delegate="{name: 'sap/ui/mdc/field/FieldBaseDelegate', payload: {}}"
                            valueHelp="statusVH"/>

                        <mdc:FilterField
                            id="idFcYearFilter"
                            propertyKey="fcYear"
                            label="{i18n>FiscalYear}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="1"
                            operators="EQ"
                            placeholder="YYYY"
                            delegate="{name: 'sap/ui/mdc/field/FieldBaseDelegate', payload: {}}"/>

                        <mdc:FilterField
                            id="idFcPeriodFilter"
                            propertyKey="fcPeriod"
                            label="{i18n>Period}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="1"
                            operators="EQ"
                            placeholder="PPP"
                            delegate="{name: 'sap/ui/mdc/field/FieldBaseDelegate', payload: {}}"/>

                    </mdc:filterItems>
                </mdc:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <mdc:Table id="idJobDetTable"
                delegate="{name:'com/bpcfn/jobscheduler/util/JSONTableDelegate', payload:{}}"
                type="Table"
                selectionMode="Single"
                selectionChange=".onJobSelected"
                rowPress=".onJobDetails"
                header="{jobModel>/JobDetailsTitle}"
                p13nMode="Sort,Column"
                class="sapUiSmallMarginTop">

                <mdc:variant>
                    <vm:VariantManagement id="tableVM" for="idJobDetTable"/>
                </mdc:variant>

                <mdc:actions>
                    <Button id="btnCreate" text="{i18n>Create}"
                        type="Emphasized"
                        press="onCreateJob"
                        enabled="{jobModel>/CreateEnabled}"/>
                    <Button id="btnCopy" text="{i18n>Copy}"
                        type="Emphasized"
                        press="onCopyJob"
                        enabled="{jobModel>/CopyEnabled}"/>
                    <MenuButton id="menuBtnCancel" text="{i18n>Cancel}"
                        type="Reject"
                        enabled="{jobModel>/CancelEnabled}">
                        <menu>
                            <Menu id="cancelMenu">
                                <MenuItem id="menuItemSelOccur"  text="{i18n>SelectedOccur}"   press="onCanSelJob"/>
                                <MenuItem id="menuItemEntJob"    text="{i18n>EntireJobSeries}" press="onCanEntJob"/>
                            </Menu>
                        </menu>
                    </MenuButton>
                    <Button id="btnManualActivity" text="Manual Activity Completed"
                        type="Accept"
                        press="onManualActivityJob"
                        enabled="{jobModel>/ManualActivityEnabled}"
                        visible="false"/>
                    <Button id="btnExport" icon="sap-icon://excel-attachment"
                        press="onExport"
                        tooltip="Export to Excel"/>
                </mdc:actions>

                <mdc:columns>

                    <mdct:Column id="colStatus" propertyKey="status" header="{i18n>Status}" width="7rem">
                        <ObjectStatus id="osStatus"
                            text="{path:'jobModel>status',  formatter:'.formatter.statusText'}"
                            state="{path:'jobModel>status', formatter:'.formatter.statusState'}"
                            inverted="false"/>
                    </mdct:Column>

                    <mdct:Column id="colJobname" propertyKey="jobname" header="{i18n>JobName}">
                        <Text id="txtJobname" text="{jobModel>jobname}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column id="colVersion" propertyKey="version" header="{i18n>Version}" width="7rem">
                        <Text id="txtVersion" text="{jobModel>version}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column id="colTaskType" propertyKey="task_type" header="{i18n>TaskType}" width="7rem">
                        <Text id="txtTaskType" text="{path:'jobModel>task_type', formatter:'.formatter.taskTypeText'}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column id="colFcYear" propertyKey="fc_year" header="{i18n>FiscalYearPeriod}" width="9rem">
                        <Text id="txtFcYear" text="{parts:[{path:'jobModel>fc_year'},{path:'jobModel>fc_period'}], formatter:'.formatter.fiscalYearPeriod'}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column id="colConGrp" propertyKey="con_grp" header="{i18n>ConsGroup}" width="8rem">
                        <Text id="txtConGrp" text="{jobModel>con_grp}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column id="colSdlStart" propertyKey="sdl_startdt" header="{i18n>PlannedStart}" width="12rem">
                        <Text id="txtSdlStart" text="{parts:[{path:'jobModel>sdl_startdt'},{path:'jobModel>sdl_starttm'}], formatter:'.formatter.formatDateTime'}"/>
                    </mdct:Column>

                    <mdct:Column id="colEnddate" propertyKey="enddate" header="{i18n>End}" width="12rem">
                        <Text id="txtEnddate" text="{parts:[{path:'jobModel>enddate'},{path:'jobModel>endtime'}], formatter:'.formatter.formatDateTime'}"/>
                    </mdct:Column>

                    <mdct:Column id="colDuration" propertyKey="duration" header="{i18n>Duration}" width="8rem">
                        <Text id="txtDuration" text="{jobModel>duration}"/>
                    </mdct:Column>

                    <mdct:Column id="colGenericUser" propertyKey="generic_user_id" header="{i18n>CreatedBy}" width="7rem">
                        <Text id="txtGenericUser" text="{= ${jobModel>generic_user_id} ? ${jobModel>generic_user_id} : ${jobModel>createdby} }" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column id="colCreatedby" propertyKey="createdby" header="{i18n>CreatedBy}" width="7rem">
                        <Text id="txtCreatedby" text="{jobModel>createdby}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column id="colCreationDate" propertyKey="creation_date" header="{i18n>CreatedOn}" width="12rem">
                        <Text id="txtCreationDate" text="{parts:[{path:'jobModel>creation_date'},{path:'jobModel>creation_time'}], formatter:'.formatter.formatDateTime'}"/>
                    </mdct:Column>

                </mdc:columns>

            </mdc:Table>
        </f:content>

    </f:DynamicPage>
</mvc:View>

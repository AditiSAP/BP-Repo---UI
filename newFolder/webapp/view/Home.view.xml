<mvc:View controllerName="com.bpcfn.jobscheduler.controller.Home"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:mdc="sap.ui.mdc"
    xmlns:mdct="sap.ui.mdc.table"
    xmlns:mdcvh="sap.ui.mdc.valuehelp"
    xmlns:mdcvc="sap.ui.mdc.valuehelp.content">

    <f:DynamicPage id="Home" class="sapUiNoContentPadding">

        <!-- ─────────────────────────────────────────────────────────────
             VALUE HELP ELEMENTS
             sap.ui.mdc.ValueHelp extends sap.ui.core.Element (not Control).
             dependents aggregation (type Element[]) is the correct home for
             Element-typed controls that must stay in scope for the whole view.
        ───────────────────────────────────────────────────────────────── -->
        <f:dependents>

            <!-- Job Name VH – replaces the original jobNameValueHelp fragment.
                 Popover = typeahead suggestions; Dialog = full F4 list.
                 Aggregation tags carry the same namespace prefix as their parent
                 class (IDE rule: aggregation namespace must match parent class). -->
            <mdc:ValueHelp id="jobNameVH"
                delegate="{name:'sap/ui/mdc/ValueHelpDelegate', payload:{}}">
                <mdc:typeahead>
                    <mdcvh:Popover>
                        <mdcvc:MTable keyPath="Jobname" descriptionPath="Jobname">
                            <Table items="{path:'custModel>/VH_Job', length:99999}" mode="SingleSelectMaster">
                                <columns><Column><Label text="{i18n>JobName}"/></Column></columns>
                                <items>
                                    <ColumnListItem type="Active">
                                        <cells><Text text="{custModel>Jobname}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                    </mdcvh:Popover>
                </mdc:typeahead>
                <mdc:dialog>
                    <mdcvh:Dialog title="{i18n>JobName}">
                        <mdcvc:MTable keyPath="Jobname" descriptionPath="Jobname">
                            <Table items="{path:'custModel>/VH_Job', length:99999}" mode="SingleSelectMaster">
                                <columns><Column><Label text="{i18n>JobName}"/></Column></columns>
                                <items>
                                    <ColumnListItem type="Active">
                                        <cells><Text text="{custModel>Jobname}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                    </mdcvh:Dialog>
                </mdc:dialog>
            </mdc:ValueHelp>

            <!-- Created By VH – replaces the original creatorValueHelp fragment. -->
            <mdc:ValueHelp id="createdByVH"
                delegate="{name:'sap/ui/mdc/ValueHelpDelegate', payload:{}}">
                <mdc:typeahead>
                    <mdcvh:Popover>
                        <mdcvc:MTable keyPath="Bname" descriptionPath="Bname">
                            <Table items="{path:'custModel>/VH_GenericUser', length:99999}" mode="SingleSelectMaster">
                                <columns><Column><Label text="{i18n>CreatedBy}"/></Column></columns>
                                <items>
                                    <ColumnListItem type="Active">
                                        <cells><Text text="{custModel>Bname}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                    </mdcvh:Popover>
                </mdc:typeahead>
                <mdc:dialog>
                    <mdcvh:Dialog title="{i18n>CreatedBy}">
                        <mdcvc:MTable keyPath="Bname" descriptionPath="Bname">
                            <Table items="{path:'custModel>/VH_GenericUser', length:99999}" mode="SingleSelectMaster">
                                <columns><Column><Label text="{i18n>CreatedBy}"/></Column></columns>
                                <items>
                                    <ColumnListItem type="Active">
                                        <cells><Text text="{custModel>Bname}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                    </mdcvh:Dialog>
                </mdc:dialog>
            </mdc:ValueHelp>

            <!-- Status VH – statusFilterModel is built in _loadStatusFilter()
                 exactly as before. Popover replaces the original MultiComboBox.
                 Multi-select is enabled via maxConditions="-1" on the field. -->
            <mdc:ValueHelp id="statusVH"
                delegate="{name:'sap/ui/mdc/ValueHelpDelegate', payload:{}}">
                <mdc:typeahead>
                    <mdcvh:Popover>
                        <mdcvc:MTable keyPath="key" descriptionPath="text">
                            <Table items="{path:'statusFilterModel>/items'}" mode="MultiSelect">
                                <columns><Column><Label text="{i18n>Status}"/></Column></columns>
                                <items>
                                    <ColumnListItem type="Active">
                                        <cells><Text text="{statusFilterModel>text}"/></cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </mdcvc:MTable>
                    </mdcvh:Popover>
                </mdc:typeahead>
            </mdc:ValueHelp>

        </f:dependents>

        <!-- ─────────────────────────────────────────────────────────────
             FILTER BAR  (sap.ui.mdc.FilterBar)
             delegate.name uses the AMD module path (slashes, no .js suffix).
             liveMode="false" → the search fires on the Go button or Enter,
             matching the original sap.ui.comp.filterbar.FilterBar behaviour.
        ───────────────────────────────────────────────────────────────── -->
        <f:header>
            <f:DynamicPageHeader>
                <mdc:FilterBar id="filterbar"
                    delegate="{name:'com/bpcfn/jobscheduler/util/FilterBarDelegate', payload:{}}"
                    search=".onRefreshData"
                    showClearButton="true"
                    liveMode="false">

                    <mdc:filterItems>

                        <!-- Job Name: valueHelp association (since 1.114)
                             references the standalone mdc:ValueHelp by id. -->
                        <mdc:FilterField
                            id="idJobNameFilter"
                            propertyKey="jobname"
                            label="{i18n>JobName}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="1"
                            operators="Contains,EQ"
                            valueHelp="jobNameVH"/>

                        <mdc:FilterField
                            id="idDateFilter"
                            propertyKey="dateRange"
                            label="{i18n>Date}"
                            dataType="sap.ui.model.type.Date"
                            maxConditions="1"
                            required="true"
                            operators="BT,GE,LE"
                            placeholder="{i18n>DateRangePlaceholder}"/>

                        <mdc:FilterField
                            id="idCreatedByFilter"
                            propertyKey="createdby"
                            label="{i18n>CreatedBy}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="1"
                            operators="Contains,EQ"
                            valueHelp="createdByVH"/>

                        <mdc:FilterField
                            id="idStatusFilter"
                            propertyKey="status"
                            label="{i18n>Status}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="-1"
                            operators="EQ"
                            valueHelp="statusVH"/>

                        <mdc:FilterField
                            id="idFcYearFilter"
                            propertyKey="fcYear"
                            label="{i18n>FiscalYear}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="1"
                            operators="EQ"
                            placeholder="YYYY"/>

                        <mdc:FilterField
                            id="idFcPeriodFilter"
                            propertyKey="fcPeriod"
                            label="{i18n>Period}"
                            dataType="sap.ui.model.type.String"
                            maxConditions="1"
                            operators="EQ"
                            placeholder="PPP"/>

                    </mdc:filterItems>
                </mdc:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <!-- ─────────────────────────────────────────────────────────────
             MDC TABLE  (sap.ui.mdc.Table)
             type="Table"          → inner sap.ui.table.Table (GridTable),
                                     matching the original control type.
             p13nMode="Sort,Column" → adds Sort and Column personalisation
                                     panels (additive over original behaviour).
             selectionMode="Single" + selectionChange → onJobSelected keeps
             the same toolbar button enable/disable logic as before.
             rowPress → onJobDetails replaces the original RowAction arrow.
        ───────────────────────────────────────────────────────────────── -->
        <f:content>
            <mdc:Table id="idJobDetTable"
                delegate="{name:'com/bpcfn/jobscheduler/util/JSONTableDelegate', payload:{}}"
                type="Table"
                selectionMode="Single"
                selectionChange=".onJobSelected"
                rowPress=".onJobDetails"
                header="{jobModel>/JobDetailsTitle}"
                p13nMode="Sort,Column"
                class="sapUiSmallMarginTop">

                <mdc:actions>
                    <Button text="{i18n>Create}"
                        type="Emphasized"
                        press="onCreateJob"
                        enabled="{jobModel>/CreateEnabled}"/>
                    <Button text="{i18n>Copy}"
                        type="Emphasized"
                        press="onCopyJob"
                        enabled="{jobModel>/CopyEnabled}"/>
                    <MenuButton text="{i18n>Cancel}"
                        type="Reject"
                        enabled="{jobModel>/CancelEnabled}">
                        <menu>
                            <Menu>
                                <MenuItem text="{i18n>SelectedOccur}"   press="onCanSelJob"/>
                                <MenuItem text="{i18n>EntireJobSeries}" press="onCanEntJob"/>
                            </Menu>
                        </menu>
                    </MenuButton>
                    <!-- Kept hidden, matching original visible="false" -->
                    <Button text="Manual Activity Completed"
                        type="Accept"
                        press="onManualActivityJob"
                        enabled="{jobModel>/ManualActivityEnabled}"
                        visible="false"/>
                    <Button icon="sap-icon://excel-attachment"
                        press="onExport"
                        tooltip="Export to Excel"/>
                </mdc:actions>

                <mdc:columns>

                    <mdct:Column propertyKey="status" header="{i18n>Status}" width="7rem">
                        <ObjectStatus
                            text="{path:'jobModel>status',  formatter:'.formatter.statusText'}"
                            state="{path:'jobModel>status', formatter:'.formatter.statusState'}"
                            inverted="false"/>
                    </mdct:Column>

                    <mdct:Column propertyKey="jobname" header="{i18n>JobName}">
                        <Text text="{jobModel>jobname}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column propertyKey="version" header="{i18n>Version}" width="7rem">
                        <Text text="{jobModel>version}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column propertyKey="task_type" header="{i18n>TaskType}" width="7rem">
                        <Text text="{path:'jobModel>task_type', formatter:'.formatter.taskTypeText'}" wrapping="false"/>
                    </mdct:Column>

                    <!-- fc_year and fc_period are separate SchedulerTask fields;
                         joined for display only via formatter.fiscalYearPeriod. -->
                    <mdct:Column propertyKey="fc_year" header="{i18n>FiscalYearPeriod}" width="9rem">
                        <Text text="{parts:[{path:'jobModel>fc_year'},{path:'jobModel>fc_period'}], formatter:'.formatter.fiscalYearPeriod'}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column propertyKey="con_grp" header="{i18n>ConsGroup}" width="8rem">
                        <Text text="{jobModel>con_grp}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column propertyKey="sdl_startdt" header="{i18n>PlannedStart}" width="12rem">
                        <Text text="{parts:[{path:'jobModel>sdl_startdt'},{path:'jobModel>sdl_starttm'}], formatter:'.formatter.formatDateTime'}"/>
                    </mdct:Column>

                    <mdct:Column propertyKey="enddate" header="{i18n>End}" width="12rem">
                        <Text text="{parts:[{path:'jobModel>enddate'},{path:'jobModel>endtime'}], formatter:'.formatter.formatDateTime'}"/>
                    </mdct:Column>

                    <mdct:Column propertyKey="duration" header="{i18n>Duration}" width="8rem">
                        <Text text="{jobModel>duration}"/>
                    </mdct:Column>

                    <!-- Shows generic_user_id when set, falls back to createdby –
                         matches the original expression binding in the old view. -->
                    <mdct:Column propertyKey="generic_user_id" header="{i18n>CreatedBy}" width="7rem">
                        <Text text="{=${jobModel>generic_user_id} === '' ? ${jobModel>createdby} : ${jobModel>generic_user_id}}" wrapping="false"/>
                    </mdct:Column>

                    <!-- Hidden column kept for P13n / export; mirrors original visible="false". -->
                    <mdct:Column propertyKey="createdby" header="{i18n>CreatedBy}" width="7rem">
                        <Text text="{jobModel>createdby}" wrapping="false"/>
                    </mdct:Column>

                    <mdct:Column propertyKey="creation_date" header="{i18n>CreatedOn}" width="12rem">
                        <Text text="{parts:[{path:'jobModel>creation_date'},{path:'jobModel>creation_time'}], formatter:'.formatter.formatDateTime'}"/>
                    </mdct:Column>

                </mdc:columns>

            </mdc:Table>
        </f:content>

    </f:DynamicPage>
</mvc:View>

<mvc:View controllerName="com.bpcfn.jobscheduler.controller.Dashboard"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    height="100%">

    <f:DynamicPage id="Dashboard" class="sapUiNoContentPadding" fitContent="false">

        <!-- ================= title ================= -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>DashTitle}"/>
                </f:heading>
                <f:snappedHeading>
                    <Title text="{i18n>DashTitle}"/>
                </f:snappedHeading>
                <f:actions>
                    <!-- Period scope. Defaults to the current FY/period (set in
                         onInit) but the user can change it - so the dashboard
                         also answers "did last period close clean", and we avoid
                         guessing the current period from the system date. -->
                    <Label text="{i18n>Version}" class="sapUiTinyMarginBegin"/>
                    <Select id="versionSelect" selectedKey="{dashModel>/scope/version}"
                            items="{dashModel>/versions}" change="onScopeChange">
                        <core:Item key="{dashModel>key}" text="{dashModel>text}"/>
                    </Select>
                    <Label text="{i18n>FiscalYear}" class="sapUiTinyMarginBegin"/>
                    <Select id="yearSelect" selectedKey="{dashModel>/scope/year}"
                            items="{dashModel>/years}" change="onScopeChange">
                        <core:Item key="{dashModel>key}" text="{dashModel>text}"/>
                    </Select>
                    <Label text="{i18n>Period}" class="sapUiTinyMarginBegin"/>
                    <Select id="periodSelect" selectedKey="{dashModel>/scope/period}"
                            items="{dashModel>/periods}" change="onScopeChange">
                        <core:Item key="{dashModel>key}" text="{dashModel>text}"/>
                    </Select>
                    <Text text="{dashModel>/contextText}" class="sapUiTinyMarginBegin sapUiTinyMarginEnd"
                          />
                    <!-- role switch: open to all, per decision. The scope shown
                         would come from the user's authorisations, not this toggle. -->
                    <SegmentedButton id="roleSwitch" selectedKey="{dashModel>/role}"
                                     selectionChange="onRoleChange">
                        <items>
                            <SegmentedButtonItem key="OPS" text="{i18n>RoleOperator}"/>
                            <SegmentedButtonItem key="MGR" text="{i18n>RoleManager}"/>
                        </items>
                    </SegmentedButton>
                    <Button icon="sap-icon://refresh" text="{i18n>Refresh}"
                            press="onRefresh" type="Transparent"/>
                    <Button text="{i18n>GoToSchedules}" icon="sap-icon://list"
                            press="onOpenSchedules" type="Transparent"/>
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>

        <!-- ================= content ================= -->
        <f:content>
            <VBox class="sapUiSmallMargin">

                <!-- ===== OPERATOR ===== -->
                <VBox id="opsBox" visible="{= ${dashModel>/role} === 'OPS' }">

                    <!-- 70 / 30 split: left = KPI tiles + timeline, right = on-hold -->
                    <HBox class="grsSplit" width="100%" wrap="Wrap" renderType="Bare">
                            <VBox class="grsLeft" width="70%">

                                <!-- KPI tiles (back from the donut). Compact,
                                     no wasted gaps: a tight tile row, not a
                                     stretched Grid. On Hold is NOT a tile - it
                                     is the table on the right. -->
                                <HBox class="grsKpiRow" wrap="Wrap">
                                    <GenericTile header="{i18n>KpiScheduled}" press="onKpiPress"
                                        app:kpi="S" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
                                        class="grsKpi">
                                        <TileContent><NumericContent value="{dashModel>/kpi/S}" valueColor="Neutral" withMargin="false"/></TileContent>
                                    </GenericTile>
                                    <GenericTile header="{i18n>KpiRunning}" press="onKpiPress"
                                        app:kpi="I" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
                                        class="grsKpi">
                                        <TileContent><NumericContent value="{dashModel>/kpi/I}" valueColor="Good" withMargin="false"/></TileContent>
                                    </GenericTile>
                                    <GenericTile header="{i18n>KpiCompleted}" press="onKpiPress"
                                        app:kpi="C" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
                                        class="grsKpi">
                                        <TileContent><NumericContent value="{dashModel>/kpi/C}" valueColor="Good" withMargin="false"/></TileContent>
                                    </GenericTile>
                                    <GenericTile header="{i18n>KpiFailed}" press="onKpiPress"
                                        app:kpi="F" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
                                        class="grsKpi">
                                        <TileContent><NumericContent value="{dashModel>/kpi/F}" valueColor="Error" withMargin="false"/></TileContent>
                                    </GenericTile>
                                    <GenericTile header="{i18n>KpiTotal}" press="onKpiPress"
                                        app:kpi="ALL" xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
                                        class="grsKpi">
                                        <TileContent><NumericContent value="{dashModel>/kpi/TOTAL}" valueColor="Neutral" withMargin="false"/></TileContent>
                                    </GenericTile>
                                    <!-- On Hold is a UNIT count from logdt, not a job status,
                                         so it does NOT navigate to Schedules (there is no
                                         "on hold" status to filter by). The held units are
                                         shown in the On-Hold panel on this page. -->
                                    <GenericTile header="{i18n>KpiOnHold}" class="grsKpi">
                                        <TileContent><NumericContent value="{dashModel>/kpi/H}" valueColor="Critical" withMargin="false"/></TileContent>
                                    </GenericTile>
                                </HBox>

                                <!-- Timeline -->
                                <f:Card class="grsCard grsScrollCard">
                                    <f:header>
                                        <card:Header title="{i18n>TodaysRuns}" subtitle="{i18n>TodaysRunsSub}"/>
                                    </f:header>
                                    <f:content>
                                        <VBox class="grsTimeline">
                                            <HBox alignItems="Center" class="grsRunDate">
                                                <Label text="{i18n>RunDate}" class="sapUiTinyMarginEnd"/>
                                                <DatePicker id="runDatePicker" value="{dashModel>/scope/runDate}"
                                                    valueFormat="yyyy-MM-dd" displayFormat="medium"
                                                    change="onRunDateChange" width="10rem"/>
                                            </HBox>
                                            <HBox class="grsRuler" justifyContent="SpaceBetween">
                                                <Text text="00:00"/><Text text="06:00"/><Text text="12:00"/><Text text="18:00"/><Text text="24:00"/>
                                            </HBox>
                                            <List items="{dashModel>/runs}" showSeparators="None" noDataText="{i18n>NoRunsToday}"
                                                  growing="true" growingThreshold="10" growingScrollToLoad="true">
                                                <CustomListItem type="Active" press="onRunPress">
                                                    <HBox alignItems="Center" class="grsLane" width="100%">
                                                        <VBox width="11rem" class="grsLaneName">
                                                            <Text text="{dashModel>jobname}" maxLines="1"/>
                                                            <Text text="{dashModel>con_grp}" class="grsLaneSub"/>
                                                        </VBox>
                                                        <VBox class="grsTrack">
                                                            <GenericTag class="grsBar" text="" design="StatusIconHidden"
                                                                status="{dashModel>barState}" tooltip="{dashModel>startText}">
                                                                <customData>
                                                                    <core:CustomData key="barleft"  value="{dashModel>barLeft}"  writeToDom="true"/>
                                                                    <core:CustomData key="barwidth" value="{dashModel>barWidth}" writeToDom="true"/>
                                                                </customData>
                                                            </GenericTag>
                                                        </VBox>
                                                        <Text class="grsStartLbl" text="{dashModel>startText}"/>
                                                    </HBox>
                                                </CustomListItem>
                                            </List>
                                            <HBox class="grsLegend">
                                                <ObjectStatus text="{i18n>KpiCompleted}" state="Success" class="sapUiTinyMarginEnd"/>
                                                <ObjectStatus text="{i18n>KpiRunning}"   state="Information" class="sapUiTinyMarginEnd"/>
                                                <ObjectStatus text="{i18n>KpiFailed}"    state="Error" class="sapUiTinyMarginEnd"/>
                                                <ObjectStatus text="{i18n>KpiScheduled}" state="None"/>
                                            </HBox>
                                        </VBox>
                                    </f:content>
                                </f:Card>
                            </VBox>
                            <!-- right 30%: on-hold units -->
                            <VBox class="grsRight" width="30%">
                                <f:Card class="grsCard grsScrollCard">
                                    <f:header>
                                        <card:Header title="{i18n>OnHoldUnits}" subtitle="{i18n>OnHoldUnitsSub}"/>
                                    </f:header>
                                    <f:content>
                                        <Table id="holdTable" items="{dashModel>/hold}" width="auto"
                                               growing="true" growingThreshold="15" growingScrollToLoad="true"
                                               noDataText="{i18n>NoHoldUnits}">
                                            <columns>
                                                <Column><Text text="{i18n>ColUnit}"/></Column>
                                                <Column><Text text="{i18n>ColJob}"/></Column>
                                                <Column><Text text="{i18n>ColTask}"/></Column>
                                                <Column><Text text="{i18n>ColReason}"/></Column>
                                            </columns>
                                            <items>
                                                <ColumnListItem>
                                                    <cells>
                                                        <Text text="{dashModel>ConUnit}"/>
                                                        <ObjectIdentifier title="{dashModel>Jobname}"/>
                                                        <Text text="{dashModel>TaskId}"/>
                                                        <ObjectStatus text="{path:'dashModel>HoldReason', formatter:'.formatter.holdReasonText'}"
                                                                      state="{path:'dashModel>HoldReason', formatter:'.formatter.holdReasonState'}"/>
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </f:content>
                                </f:Card>
                            </VBox>
                    </HBox>
                </VBox>

                <!-- ===== CLOSE MANAGER (built lazily by the controller) ===== -->
                <VBox id="mgrBox" visible="{= ${dashModel>/role} === 'MGR' }">
                    <!-- scope banner -->
                    <MessageStrip class="sapUiSmallMarginBottom"
                        text="{dashModel>/mgrScopeText}" type="Information" showIcon="true"/>

                    <f:Card class="sapUiTinyMargin">
                        <f:header><card:Header title="{i18n>NeedsAction}" subtitle="{i18n>NeedsActionSub}"/></f:header>
                        <f:content>
                            <Table items="{dashModel>/actions}" width="auto" noDataText="{i18n>NoActions}">
                                <columns>
                                    <Column width="6rem"><Text text="{i18n>ColPriority}"/></Column>
                                    <Column><Text text="{i18n>ColGroup}"/></Column>
                                    <Column><Text text="{i18n>ColIssue}"/></Column>
                                    <Column width="9rem"><Text text="{i18n>ColAction}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectStatus text="{dashModel>priority}" state="{dashModel>priorityState}"/>
                                            <Text text="{dashModel>group}"/>
                                            <Text text="{dashModel>issue}"/>
                                            <Button text="{dashModel>actionText}" type="Transparent" press="onActionPress"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </f:content>
                    </f:Card>

                    <l:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="1" containerQuery="true">
                        <f:Card class="sapUiTinyMargin">
                            <f:header><card:Header title="{i18n>PeriodReadiness}" subtitle="{i18n>PeriodReadinessSub}"/></f:header>
                            <f:content>
                                <Table items="{dashModel>/readiness}" width="auto" noDataText="{i18n>MgrPanelPending}">
                                    <columns>
                                        <Column><Text text="{i18n>ColGroup}"/></Column>
                                        <Column><Text text="{i18n>ColDataMon}"/></Column>
                                        <Column><Text text="{i18n>ColConsMon}"/></Column>
                                        <Column><Text text="{i18n>ColCanClose}"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Text text="{dashModel>group}"/>
                                                <ObjectStatus text="{dashModel>dmText}" state="{dashModel>dmState}"/>
                                                <ObjectStatus text="{dashModel>cmText}" state="{dashModel>cmState}"/>
                                                <ObjectStatus text="{dashModel>canText}" state="{dashModel>canState}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </f:content>
                        </f:Card>
                    </l:Grid>

                    <f:Card class="sapUiTinyMargin">
                        <f:header><card:Header title="{i18n>SeriesHealth}" subtitle="{i18n>SeriesHealthSub}"/></f:header>
                        <f:content>
                            <Table items="{dashModel>/series}" width="auto" noDataText="{i18n>MgrPanelPending}">
                                <columns>
                                    <Column><Text text="{i18n>ColSchedule}"/></Column>
                                    <Column><Text text="{i18n>ColGroup}"/></Column>
                                    <Column><Text text="{i18n>ColCadence}"/></Column>
                                    <Column><Text text="{i18n>ColStreak}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{dashModel>name}"/>
                                            <Text text="{dashModel>group}"/>
                                            <Text text="{dashModel>cadence}"/>
                                            <ObjectStatus text="{dashModel>streak}" state="{dashModel>streakState}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </f:content>
                    </f:Card>
                </VBox>

            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>